{
    "name": "fam",
    "scopeName": "source.fam",
    "fileTypes": ["fam"],
    "patterns": [
        { "include": "#strings" },
        { "include": "#comments" },
        { "include": "#parenthesised_names"},
        { "include": "#literals" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#constants" },
        { "include": "#operators" },
        { "include": "#names" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.fam",
                    "begin": "\"",
                    "end": "(?<!\\\\)\\\"",
                    "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fam" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.string.end.fam" } },
                    "patterns": [
                        {
                            "comment": "escape characters",
                            "name": "constant.character.escape.fam",
                            "match": "\\\\([\\\\'\"abfnrtv]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\\{[^}]+\\}|[0-7]{1,3})"
                        },
                        {
                            "comment": "format specifier",
                            "name": "constant.character.format.placeholder.fam",
                            "match": "%(s|[0-9]*?d|\\+?(\\.[0-9]+?)?f|\\+?[0-9]+?(\\.[0-9]+?)?f)"
                        }
                    ]
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "comment": "line comments",
                    "name": "comment.fam",
                    "match": "#.*$"
                }
            ]
        },
        "parenthesised_names": {
            "patterns": [
                {
                    "comment": "parenthesised title case names",
                    "match": "(\\()(_*[A-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*(?:\\s+[_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*)*)(\\))",
                    "captures": {
                        "1": { "name": "punctuation.fam" },
                        "2": { "name": "entity.name.type.parenthesised.fam" },
                        "3": { "name": "punctuation.fam" }
                    }
                },
                {
                    "comment": "parenthesised names",
                    "match": "(\\()(_*[a-z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*(?:\\s+[_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*)*)(\\))",
                    "captures": {
                        "1": { "name": "punctuation.fam" },
                        "2": { "name": "entity.name.type.parenthesised.fam" },
                        "3": { "name": "punctuation.fam" }
                    }
                }
            ]
        },
        "literals": {
            "patterns": [
                {
                    "comment": "datetime literals",
                    "name": "constant.numeric.date.fam",
                    "match": "(?:[0-2]?[0-9]:[0-5][0-9](?::[0-5][0-9](?:\\.[0-9]*)?)?\\s+(?:am|pm\\s+)?)?[0-3]?[0-9]-[0-1]?[0-9]-[0-9]+"
                },
                {
                    "comment": "duration literals",
                    "name": "constant.numeric.duration.fam",
                    "match": "(?:[0-9]+d\\s+)?[0-9]+:[0-5][0-9](:[0-5][0-9])?(\\.[0-9]*)?"
                },
                {
                    "comment": "real numbers",
                    "name": "constant.numeric.real.fam",
                    "match": "\\d+\\.?\\d*"
                },
                {
                    "comment": "integers",
                    "name": "constant.numeric.integer.fam",
                    "match": "\\d+"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "comment": "variable",
                    "match": "\\b(Define)\\s+(.*)\\s+(Variable)\\b",
                    "captures": {
                        "1": { "name": "keyword.control.flow.fam" },
                        "2": {
                            "patterns": [
                                { "include": "#strings" },
                                { "include": "#comments" },
                                { "include": "#literals" },
                                { "include": "#keywords" },
                                { "include": "#builtins" },
                                { "include": "#constants" },
                                { "include": "#operators" },
                                { "include": "#names" },
                                { "include": "#punctuation" }
                            ]
                        },
                        "3": { "name": "storage.type.variable.fam" }
                    }
                },
                {
                    "comment": "link declaration",
                    "match": "\\b(Link)\\s+(.*)\\s+(From)\\s+(.*)\\s+(->)\\s+(.*)\\b",
                    "captures": {
                        "1": { "name": "storage.type.link.fam" },
                        "2": { "name": "entity.name.type.title-case.fam" },
                        "3": { "name": "storage.type.link.from.fam" },
                        "4": { "name": "entity.name.type.title-case.fam" },
                        "5": { "name": "keyword.operator.arrow-right.fam" },
                        "6": { "name": "entity.name.type.title-case.fam" }
                    }
                },
                {
                    "comment": "define",
                    "name": "keyword.control.flow.fam",
                    "match": "Define"
                },
                {
                    "comment": "default",
                    "name": "keyword.control.flow.fam",
                    "match": "Default"
                },
                {
                    "comment": "method",
                    "name": "storage.type.function.fam",
                    "match": "Method"
                },
                {
                    "comment": "return",
                    "name": "keyword.control.flow.fam",
                    "match": "Return"
                },
                {
                    "comment": "display",
                    "name": "keyword.control.flow.fam",
                    "match": "Display"
                },
                {
                    "comment": "if",
                    "name": "keyword.control.flow.fam",
                    "match": "If"
                },
                {
                    "comment": "else",
                    "name": "keyword.control.flow.fam",
                    "match": "Else"
                },
                {
                    "comment": "node",
                    "name": "storage.type.node.fam",
                    "match": "Node"
                },
                {
                    "comment": "link",
                    "name": "storage.type.link.fam",
                    "match": "Link"
                },
                {
                    "comment": "attribute",
                    "name": "storage.type.attribute.fam",
                    "match": "\\bAttribute\\b"
                },
                {
                    "comment": "constraints",
                    "name": "storage.type.constraints.fam",
                    "match": "Constraints"
                },
                {
                    "comment": "inferred link",
                    "name": "storage.type.link.inferred.fam",
                    "match": "Inferred"
                },
                {
                    "comment": "implicit link",
                    "name": "storage.type.link.implicit.fam",
                    "match": "Implicit"
                },
                {
                    "comment": "identity operator",
                    "name": "keyword.operator.logical.fam",
                    "match": "\\bIs\\b"
                },
                {
                    "comment": "negation operator",
                    "name": "keyword.operator.logical.fam",
                    "match": "\\bNot\\b"
                },
                {
                    "comment": "no-op syntax filler",
                    "name": "keyword.control.flow.fam",
                    "match": "\\bPass\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "comment": "built-in types",
                    "name": "support.type.builtin.fam",
                    "match": "\\b(Integer|Int|Sequence|Seq|Real|Node|Link|Datetime|Duration|Boolean)\\b"
                },
                {
                    "comment": "built-in functions",
                    "name": "support.function.builtin.fam",
                    "match": "\\b(abs|floor|ceil|round|today|now)\\b"
                },
                {
                    "comment": "special variables",
                    "name": "variable.language.special.fam",
                    "match": "\\b(Me|This)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "comment": "none",
                    "name": "constant.language.null.fam",
                    "match": "None"
                },
                {
                    "comment": "true",
                    "name": "constant.language.true.fam",
                    "match": "True"
                },
                {
                    "comment": "false",
                    "name": "constant.language.false.fam",
                    "match": "False"
                }
            ]
        },
        "names": {
            "patterns": [
                {
                    "comment": "method call",
                    "match": "(\\.)([_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*|\\([_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*(?:\\s+[_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*)*\\))(\\()",
                    "captures": {
                        "1": { "name": "punctuation.attribute-access.fam" },
                        "2": { "name": "entity.name.function.fam" },
                        "3": { "name": "punctuation.fam" }
                    }
                },
                {
                    "comment": "attribute access",
                    "match": "(\\.)([_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*|\\([_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*(?:\\s+[_a-zA-Z][_a-zA-Z0-9]*(?:-?[_a-zA-Z0-9]+)*)*\\))",
                    "captures": {
                        "1": { "name": "punctuation.attribute-access.fam" },
                        "2": { "name": "meta.attribute.fam" }
                    }
                },
                {
                    "comment": "attribute value pair in node declaration",
                    "match": "^\\s*(.+)\\s*(:)\\s*(.+)$",
                    "captures": {
                        "1": { "name": "meta.attribute.fam" },
                        "2": { "name": "punctuation.section.fam" },
                        "3": {
                            "patterns": [
                                { "include": "#strings" },
                                { "include": "#comments" },
                                { "include": "#literals" },
                                { "include": "#keywords" },
                                { "include": "#builtins" },
                                { "include": "#constants" },
                                { "include": "#operators" },
                                { "include": "#names" },
                                { "include": "#punctuation" }
                            ]
                        }
                    }
                },
                {
                    "comment": "title case identifiers",
                    "name": "entity.name.type.title-case.fam",
                    "match": "\\b_*[A-Z][_a-zA-Z0-9]*(-?[_a-zA-Z0-9]+)*\\b"
                },
                {
                    "comment": "snake_case identifiers with hyphens",
                    "name": "entity.name.function.lowercase.fam",
                    "match": "\\b_*[a-z][_a-zA-Z0-9]*(-?[_a-zA-Z0-9]+)*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "comment": "right single-ended arrow",
                    "name": "keyword.operator.arrow-right.fam",
                    "match": "->"
                },
                {
                    "comment": "double-ended arrow",
                    "name": "keyword.operator.arrow-double.fam",
                    "match": "<->"
                },
                {
                    "comment": "implication arrow",
                    "name": "keyword.operator.implication.fam",
                    "match": "=>"
                },
                {
                    "comment": "binary add",
                    "name": "keyword.operator.arithmetic.fam",
                    "match": "\\+"
                },
                {
                    "comment": "binary subtract",
                    "name": "keyword.operator.arithmetic.fam",
                    "match": "-"
                },
                {
                    "comment": "indices / exponentiation",
                    "name": "keyword.operator.arithmetic.fam",
                    "match": "\\*\\*"
                },
                {
                    "comment": "binary multiply",
                    "name": "keyword.operator.arithmetic.fam",
                    "match": "\\*"
                },
                {
                    "comment": "binary divide",
                    "name": "keyword.operator.arithmetic.fam",
                    "match": "\\/"
                },
                {
                    "comment": "bitwise or",
                    "name": "keyword.operator.bitwise.fam",
                    "match": "\\|"
                },
                {
                    "comment": "comparative equality",
                    "name": "keyword.operator.comparison.fam",
                    "match": "=="
                },
                {
                    "comment": "greater than or equal to",
                    "name": "keyword.operator.comparison.fam",
                    "match": ">="
                },
                {
                    "comment": "less than or equal to",
                    "name": "keyword.operator.comparison.fam",
                    "match": "<="
                },
                {
                    "comment": "greater than",
                    "name": "keyword.operator.comparison.fam",
                    "match": ">"
                },
                {
                    "comment": "less than",
                    "name": "keyword.operator.comparison.fam",
                    "match": "<"
                },
                {
                    "comment": "assignment",
                    "name": "keyword.operator.assignment.fam",
                    "match": "="
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "comment": "dot",
                    "name": "punctuation.attribute-access.fam",
                    "match": "\\."
                },
                {
                    "comment": "comma",
                    "name": "punctuation.separator.comma.fam",
                    "match": ","
                },
                {
                    "comment": "colon",
                    "name": "punctuation.section.fam",
                    "match": ":"
                },
                {
                    "comment": "parentheses, brackets, braces",
                    "name": "punctuation.fam",
                    "match": "[\\(\\)\\[\\]\\{\\}]"
                }
            ]
        }
    }
}